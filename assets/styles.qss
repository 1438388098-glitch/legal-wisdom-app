/* 法律智库 — 极简衬线学术风 */
/* Based on: Noto Serif SC / Inter, #8B4513 accent, low saturation */
/* NOTE: "Noto Serif SC" is a Google font and requires separate installation on
   Windows. If missing, the fallback chain (STSong -> SimSun) will apply. */

/* ===== Global ===== */
QWidget {
    font-family: "Noto Serif SC", "Source Han Serif SC", "STSong", "SimSun", serif;
    font-size: 14px;
    color: #1a1a1a;
    background: #ffffff;
}

QMainWindow {
    background: #ffffff;
}

/* ===== Title Bar ===== */
#titleBar {
    background: #ffffff;
    border-bottom: 1px solid #e8e8e8;
    padding: 0px;
    min-height: 48px;
}

#titleLabel {
    font-family: "Noto Serif SC", "Source Han Serif SC", "STSong", serif;
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    padding-left: 24px;
    letter-spacing: 2px;
}

#titleSubLabel {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 12px;
    color: #999;
    padding-left: 8px;
}

/* ===== Search Bar ===== */
#searchInput {
    font-family: "Noto Serif SC", "Source Han Serif SC", serif;
    font-size: 14px;
    padding: 10px 16px;
    border: none;
    border-radius: 0px;
    background: transparent;
    color: #1a1a1a;
}

#searchInput::placeholder {
    color: #aaa;
    font-style: italic;
}

#searchButton {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    background: transparent;
    color: #8B4513;
    border: 1px solid #8B4513;
    border-radius: 2px;
    padding: 6px 18px;
    min-width: 56px;
}

#searchButton:hover {
    background: #8B4513;
    color: #ffffff;
}

#searchButton:disabled {
    color: #ccc;
    border-color: #ccc;
}

#categoryCombo {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 12px;
    background: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 2px;
    padding: 6px 12px;
    min-width: 80px;
    color: #666;
}

#categoryCombo:hover {
    border-color: #8B4513;
}

/* ===== Sidebar ===== */
#sidebar {
    background: #ffffff;
    border-right: 1px solid #e8e8e8;
    border-radius: 0px;
    margin: 0px;
}

#sidebarTitle {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #999;
    padding: 16px 16px 6px 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

QTreeWidget {
    border: none;
    background: transparent;
    font-size: 13px;
    padding: 4px;
    outline: none;
    font-family: "Noto Serif SC", serif;
}

QTreeWidget::item {
    padding: 7px 14px;
    border-radius: 2px;
    margin: 1px 6px;
    color: #666;
}

QTreeWidget::item:selected {
    background: rgba(139, 69, 19, 0.08);
    color: #8B4513;
    font-weight: 500;
}

QTreeWidget::item:hover {
    background: rgba(139, 69, 19, 0.04);
    color: #1a1a1a;
}

QTreeWidget::branch {
    background: transparent;
}

/* ===== Content Area ===== */
#contentArea {
    background: #ffffff;
    border: none;
    margin: 0px;
}

#resultTitle {
    font-family: "Noto Serif SC", serif;
    font-size: 13px;
    font-weight: 500;
    color: #999;
    padding: 16px 20px 8px 20px;
}

/* ===== Result List ===== */
QListWidget {
    border: none;
    background: transparent;
    font-size: 14px;
    outline: none;
}

QListWidget::item {
    padding: 12px 20px;
    border-bottom: 1px solid #f0f0f0;
    color: #1a1a1a;
}

QListWidget::item:selected {
    background: rgba(139, 69, 19, 0.06);
    color: #1a1a1a;
}

QListWidget::item:hover {
    background: rgba(139, 69, 19, 0.03);
}

/* ===== Document Viewer ===== */
QTextBrowser#docViewer {
    border: none;
    background: #ffffff;
    font-family: "Noto Serif SC", "Source Han Serif SC", "STSong", "SimSun", serif;
    font-size: 15px;
    line-height: 1.8;
    padding: 24px;
    color: #1a1a1a;
    selection-background-color: rgba(139, 69, 19, 0.12);
}

#docTitle {
    font-family: "Noto Serif SC", "Source Han Serif SC", serif;
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    padding: 8px 24px;
    letter-spacing: 1px;
}

#docMeta {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 12px;
    color: #999;
    padding: 0px 24px 16px 24px;
}

/* ===== Tabs ===== */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 12px;
    background: transparent;
    color: #999;
    padding: 8px 20px;
    margin: 0px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #8B4513;
    border-bottom: 2px solid #8B4513;
    font-weight: 500;
}

QTabBar::tab:hover:!selected {
    color: #666;
}

/* ===== AI Panel ===== */
#aiPanel {
    background: #ffffff;
    border-top: 1px solid #e8e8e8;
    margin: 0px;
}

#aiInput {
    font-family: "Noto Serif SC", serif;
    font-size: 14px;
    border: 1px solid #e8e8e8;
    border-radius: 2px;
    padding: 10px 14px;
    background: #ffffff;
    color: #1a1a1a;
}

#aiInput:focus {
    border: 1px solid #8B4513;
}

#aiInput::placeholder {
    color: #aaa;
    font-style: italic;
}

#sendButton {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    background: transparent;
    color: #8B4513;
    border: 1px solid #8B4513;
    border-radius: 2px;
    padding: 8px 20px;
}

#sendButton:hover {
    background: #8B4513;
    color: #ffffff;
}

#sendButton:disabled {
    color: #ccc;
    border-color: #ccc;
}

#contextButton {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    background: #8B4513;
    color: #ffffff;
    border: 1px solid #8B4513;
    border-radius: 2px;
    padding: 8px 20px;
}

#contextButton:hover {
    background: #1a1a1a;
    border-color: #1a1a1a;
}

#contextButton:disabled {
    background: #ccc;
    border-color: #ccc;
}

QTextBrowser#aiOutput {
    border: 1px solid #e8e8e8;
    background: #fafafa;
    font-family: "Noto Serif SC", serif;
    font-size: 14px;
    line-height: 1.7;
    padding: 16px;
    color: #1a1a1a;
}

/* ===== Action Buttons ===== */
#bookmarkBtn, #settingsBtn, #expandButton {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 12px;
    background: transparent;
    color: #666;
    border: 1px solid #e8e8e8;
    border-radius: 2px;
    padding: 5px 14px;
}

#bookmarkBtn:hover, #settingsBtn:hover, #expandButton:hover {
    color: #8B4513;
    border-color: #8B4513;
}

#expandButton {
    font-size: 11px;
    padding: 3px 10px;
    color: #999;
}

/* ===== Scrollbar ===== */
QScrollBar:vertical {
    width: 6px;
    background: transparent;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #d0d0d0;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #b0b0b0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 6px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    background: #d0d0d0;
    border-radius: 3px;
    min-width: 30px;
}

/* ===== Dialog ===== */
QDialog {
    background: #ffffff;
    border: 1px solid #e8e8e8;
}

QDialog QLabel {
    font-family: "Noto Serif SC", serif;
    font-size: 14px;
    color: #1a1a1a;
}

QDialog QLineEdit {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    border: 1px solid #e8e8e8;
    border-radius: 2px;
    padding: 8px;
    color: #1a1a1a;
}

QDialog QPushButton {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    background: transparent;
    color: #8B4513;
    border: 1px solid #8B4513;
    border-radius: 2px;
    padding: 6px 18px;
}

QDialog QPushButton:hover {
    background: #8B4513;
    color: #ffffff;
}

QDialog QComboBox {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    border: 1px solid #e8e8e8;
    border-radius: 2px;
    padding: 6px;
}

/* ===== Status Bar ===== */
QStatusBar {
    font-family: "Inter", "Segoe UI", sans-serif;
    background: #fafafa;
    border-top: 1px solid #e8e8e8;
    font-size: 11px;
    color: #aaa;
    padding: 4px 12px;
}
